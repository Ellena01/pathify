# ==============================================================================
# Pathify — Environment Configuration (.env.example)
# Copy this file to .env.local and fill in the required values.
# NEVER commit .env.local or expose secret keys in client bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (REQUIRED for Authentication, User Profiles, Database & RLS)
# ------------------------------------------------------------------------------
# Create a project at https://supabase.com
# URL and anon key are exposed to the browser for client-side Auth & queries.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_supabase_anon_key

# Service role key (SERVER ONLY - NEVER prefix with NEXT_PUBLIC).
# Required for server-side sync (/api/sync) and admin scripts (e.g. provision-demo-user).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. Demo User Configuration (OPTIONAL - Used by `npm run seed:demo`)
# ------------------------------------------------------------------------------
# Override default demo account credentials for testing & QA workflows.
DEMO_USER_EMAIL=demo@pathify.app
DEMO_USER_PASSWORD=your_secure_demo_password_here

# ------------------------------------------------------------------------------
# 3. Opportunity Discovery & Ingestion (Apify)
# ------------------------------------------------------------------------------
# Apify token and dataset ID for automated scraping & opportunity ingestion.
# (Server-only — never prefix with NEXT_PUBLIC).
APIFY_TOKEN=apify_api_...
APIFY_DATASET_ID=7vWfQxcWXaL9qJShK

# ------------------------------------------------------------------------------
# 4. Scheduled Sync & Security Secret
# ------------------------------------------------------------------------------
# Secret token to authenticate cron / webhook triggers for /api/sync & /api/alerts/dispatch.
# Generate via: openssl rand -hex 32
CRON_SECRET=generate_random_secret_hex_32

# ------------------------------------------------------------------------------
# 5. Email & Digest Alerts (Resend)
# ------------------------------------------------------------------------------
# (Server-only) Used by /api/alerts/dispatch for daily/weekly match digests.
RESEND_API_KEY=re_...your_resend_api_key
ALERTS_FROM_EMAIL=Pathify <alerts@pathify.app>
NEXT_PUBLIC_SITE_URL=https://pathify.app

# ------------------------------------------------------------------------------
# 6. AI Intelligence (Google Gemini Navigator)
# ------------------------------------------------------------------------------
# (Server-only) Used by /api/navigator for natural language discovery & reasoning.
# If omitted, Navigator automatically falls back to the deterministic keyword engine.
GEMINI_API_KEY=your_gemini_api_key

