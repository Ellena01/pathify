# Pathify — Supabase (new project: pathify) + Apify
# Copy to .env.local and fill values. Never commit .env.local

# Supabase — create new project at supabase.com (pathify)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Optional: service_role only for server-side cron/sync (never prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Apify — server-only (never NEXT_PUBLIC)
APIFY_TOKEN=apify_api__YOUR_TOKEN
APIFY_DATASET_ID=7vWfQxcWXaL9qJShK

# Optional: scheduled sync secret for cron endpoint
CRON_SECRET=generate_random_secret
